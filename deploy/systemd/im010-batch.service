# /etc/systemd/system/im010-batch.service
# 배포: backend/im010-batch/build/libs/im010-batch-*.jar → /opt/im010/batch/im010-batch.jar
# 환경 변수(DB 비밀번호 등)는 /etc/im010/batch.env (권한 600, 소유자 im010)에 둔다.

[Unit]
Description=im010 수집 배치 (크롤링 · 변경 감지 · 예약 게시)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=im010
Group=im010
WorkingDirectory=/opt/im010/batch
EnvironmentFile=/etc/im010/batch.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -jar /opt/im010/batch/im010-batch.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
# 보안 하드닝
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
