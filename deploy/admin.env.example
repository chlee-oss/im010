# /etc/im010/admin.env 예시 — 실제 값은 서버에서만 작성하고 저장소에 올리지 않는다.
IM010_DB_URL=jdbc:postgresql://DB_HOST:5432/im010
IM010_DB_USER=im010
IM010_DB_PASSWORD=
# 알뜰AI 이미지 저장 폴더 (api 와 같은 경로, 소유자 im010)
IM010_UPLOAD_DIR=/opt/im010/uploads
# 관리자가 한 명도 없을 때만 최고관리자 계정을 만든다. 첫 로그인(OTP 등록 · 비밀번호 변경) 후 이 줄은 지운다
IM010_ADMIN_BOOTSTRAP_LOGIN_ID=admin
IM010_ADMIN_BOOTSTRAP_PASSWORD=
