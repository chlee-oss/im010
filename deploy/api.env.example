# /etc/im010/api.env 예시 — 실제 값은 서버에서만 작성하고 저장소에 올리지 않는다.
IM010_DB_URL=jdbc:postgresql://DB_HOST:5432/im010
IM010_DB_USER=im010
IM010_DB_PASSWORD=
IM010_FRONT_BASE_URL=https://www.im010.co.kr
# 알뜰AI 이미지 폴더 (admin 과 같은 경로, 소유자 im010). 운영은 nginx 가 /uploads/ 를 직접 내려준다
IM010_UPLOAD_DIR=/opt/im010/uploads
