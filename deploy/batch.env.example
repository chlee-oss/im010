# /etc/im010/batch.env 예시 — 실제 값은 서버에서만 작성하고 저장소에 올리지 않는다.
# 배치는 한 대에서만 실행한다 (작업 큐는 동시 실행을 막지만 스케줄 확인 · 예약 게시는 한 곳이 맡는다)
IM010_DB_URL=jdbc:postgresql://DB_HOST:5432/im010
IM010_DB_USER=im010
IM010_DB_PASSWORD=

# 알림 메일 (선택) — 없으면 메일은 보내지 않고 메신저 채널로만 발송
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
IM010_MAIL_FROM=im010 <noreply@im010.co.kr>
# 메신저 채널은 환경 변수가 아니라 백오피스 관리자관리 › 알림 채널에서 등록한다
